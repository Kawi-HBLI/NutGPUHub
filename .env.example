# Copy this file to .env and replace the placeholders with your own local values.
# Never commit .env. Values here are placeholders, not real credentials.
# Full table (purpose, secret or not, where the cloud value comes from): docs/labs/lab-05/deployment.md

# PostgreSQL for the app. Secret in the cloud (Secret Manager).
DATABASE_URL=postgresql://nutgpuhub:password@localhost:5432/nutgpuhub
# Separate, migrated database for npm test, test:e2e and verify:restart. Must differ from DATABASE_URL. Local/CI only.
TEST_DATABASE_URL=postgresql://nutgpuhub:password@localhost:5432/nutgpuhub_test
# Password the seed gives every demo account (12-256 characters). Secret in the cloud (Secret Manager).
DEMO_PASSWORD=replace-this-local-demo-password
# The one origin allowed to send POST/PUT/DELETE. Must equal the URL users open (the Cloud Run URL in the cloud).
APP_ORIGIN=http://localhost:5173
# Fixed for Sprint 1: omit it or set exactly 60.
SESSION_TTL_MINUTES=60
# Secure cookie flag. Set automatically when APP_ORIGIN is https; keep false for local http.
COOKIE_SECURE=false
# HTTP port. Cloud Run sets it at runtime.
PORT=3000

# Optional settings. Remove the # only when you need them.
# Bind address. Default 127.0.0.1 (local only). The container image sets 0.0.0.0.
# HOST=127.0.0.1
# Legacy fallback for APP_ORIGIN, used only when APP_ORIGIN is unset or empty. Prefer APP_ORIGIN.
# PUBLIC_ORIGIN=http://localhost:5173
# Runtime mode. The container and Cloud Run use production; the app code does not branch on it.
# NODE_ENV=development
# Full commit SHA shown in the footer and /api/version. Set on Cloud Run by deploy/release.sh; leave unset locally.
# APP_COMMIT=0000000000000000000000000000000000000000

# Docker Compose only (docker-compose.yml). Compose also reads DEMO_PASSWORD above.
# POSTGRES_USER=nutgpuhub
# POSTGRES_PASSWORD=replace-this-local-db-password
# POSTGRES_DB=nutgpuhub
# APP_PORT=3000
