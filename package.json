{
  "name": "nutgpuhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx server/index.ts",
    "dev:web": "vite --host localhost",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.45.1",
    "express": "4.22.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  }
}
