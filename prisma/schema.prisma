generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  operator
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(80)
  passwordHash String    @map("password_hash")
  role         Role
  sessions     Session[]
  machines     GpuMachine[]
  bookings     Booking[]

  @@map("users")
}

model GpuMachine {
  id         Int    @id @default(autoincrement())
  code       String @unique @db.VarChar(40)
  operatorId Int    @map("operator_id")
  operator   User   @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  slots      Slot[]

  @@index([operatorId])
  @@map("gpu_machines")
}

model Slot {
  id        Int        @id @default(autoincrement())
  machineId Int        @map("machine_id")
  startAt   DateTime   @map("start_at") @db.Timestamptz(3)
  machine   GpuMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@unique([machineId, startAt])
  @@unique([id, startAt])
  @@map("slots")
}

model Booking {
  id          Int      @id @default(autoincrement())
  slotId      Int      @map("slot_id")
  studentId   Int      @map("student_id")
  slotStartAt DateTime @map("slot_start_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  slot        Slot     @relation(fields: [slotId, slotStartAt], references: [id, startAt], onDelete: Restrict)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([slotId])
  @@unique([studentId, slotStartAt])
  @@map("bookings")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
